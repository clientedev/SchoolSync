{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT production_app:app --timeout 120 --workers 1 --threads 4 --max-requests 1000 --log-level info",
    "healthcheckPath": "/ping",
    "healthcheckTimeout": 300,
    "numReplicas": 1,
    "sleepApplication": true,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
